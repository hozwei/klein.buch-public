<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Klein.Buch — Rust-Bibliotheken</title>
<link rel="stylesheet" href="/legal/legal.css">
</head>
<body>
<main class="legal">
<h1>Klein.Buch — Rust-Bibliotheken</h1>
<!-- kb:rust:begin -->
<p class="meta">
  Erzeugt aus <code>Cargo.lock</code> per
  <a href="https://github.com/EmbarkStudios/cargo-about">cargo-about</a> für
  <code>x86_64-unknown-linux-gnu</code>, ohne Entwicklungs- und Build-Abhängigkeiten.
  Die Hinweise nach Apache-2.0 (NOTICE-Dateien), die Lizenzen des mitgelieferten
  C-Codes (SQLCipher, OpenSSL), die eingebetteten Schriften sowie die Java- und
  JavaScript-Komponenten stehen in den weiteren Abschnitten dieser Seite.
</p>

<h3>Übersicht</h3>
<ul class="overview">
{{#each overview}}
  <li><a href="#rust-{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>

{{#each licenses}}
<section class="license">
  {{#if first_of_kind}}<h3 id="rust-{{id}}">{{name}}</h3>{{/if}}
  <h4 id="rust-{{id}}-{{@index}}">{{name}} <span class="spdx">(SPDX: {{id}})</span></h4>
  <ul class="used-by">
  {{#each used_by}}
    <li><strong>{{crate.name}} {{crate.version}}</strong>{{#if crate.repository}} — <code>{{crate.repository}}</code>{{/if}}</li>
  {{/each}}
  </ul>
  <pre class="license-text">{{text}}</pre>
</section>
{{/each}}
<!-- kb:rust:end -->
</main>
</body>
</html>
