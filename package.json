{
  "name": "klein-buch",
  "version": "0.0.0",
  "versionNote": "Single Source = src-tauri/Cargo.toml (CalVer). Diese Zahl wird nirgendwo gelesen; das Frontend liest die Version per appInfo() bzw. /api/public/info vom Server. Bewusst auf 0.0.0 gepinnt, damit niemand sie versehentlich für die App-Version hält.",
  "description": "EÜR-Buchhaltung für deutsche §19-Kleinunternehmer als selbst gehostete Webanwendung (Rust + Svelte 5, Docker).",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "TZ=UTC vitest run"
  },
  "license": "AGPL-3.0-or-later",
  "repository": "https://github.com/hozwei/klein.buch-public",
  "dependencies": {
    "marked": "^15.0.7",
    "minisearch": "^7.1.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
