  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^22.10.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~6.0.3",
    "vite": "^6.0.3",
    "vitest": "^3.2.7"
  }
