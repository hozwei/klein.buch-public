{
  // Basis erzeugt SvelteKit 3 (`svelte-kit sync`) unter node_modules/$app/tsconfig.json:
  // strict-fähige Bundler-Auflösung, verbatimModuleSyntax, isolatedModules, noEmit,
  // allowImportingTsExtensions (Importe wie "#lib/api.ts", Subpath-Import aus package.json).
  "extends": "$app/tsconfig",
  "compilerOptions": {
    // TypeScript 6 lädt keine @types-Pakete mehr automatisch: node für vite.config.js und Tests.
    "types": ["$app/types", "node"],
    "sourceMap": true,
    "strict": true
  },
  "include": ["src", "*"],
  "exclude": ["src/service-worker"]
}
